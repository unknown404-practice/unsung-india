# =========================================================
# UNSUNG HEROES OF INDIA - PRODUCTION CLOUD AI CONFIGURATION
# =========================================================

# 1. OpenRouter (Recommended: Qwen 2.5 72B / 32B)
OPENROUTER_API_KEY=sk-or-v1-...

# 2. NVIDIA NIM API (Enterprise Llama 3.3 70B / Qwen 2.5 72B)
NVIDIA_NIM_API_KEY=nvapi-...

# 3. Hugging Face Inference API (Qwen 2.5 72B Instruct)
HUGGINGFACE_API_KEY=hf_...

# 4. Groq Ultra-Fast Inference (500 tokens/sec)
GROQ_API_KEY=gsk_...

# Database & Security
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/unsung_heroes
JWT_SECRET_KEY=change_this_to_a_secure_random_key_in_production
