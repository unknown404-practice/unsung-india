# Application Configuration
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="Unsung Heroes of India"
API_V1_STR=/api/v1

# Server & CORS
PORT=8000
ALLOWED_ORIGINS=["http://localhost:3000","https://unsung-heroes.vercel.app"]

# PostgreSQL Database (Neon / Supabase Serverless Postgres Connection String)
# For local dev: postgresql+asyncpg://postgres:postgres@localhost:5432/unsung_heroes
# For Neon: postgresql+asyncpg://user:pass@ep-cool-pool-123456.ap-southeast-1.aws.neon.tech/unsung_heroes?ssl=require
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/unsung_heroes

# Security & JWT Token
JWT_SECRET_KEY=change_this_to_a_super_secret_key_in_production_min_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Initial Admin Credentials (for seed script)
INITIAL_ADMIN_EMAIL=admin@unsungheroes.gov.in
INITIAL_ADMIN_PASSWORD=Admin@UnsungHeroes2026!
